# Every setting is optional; defaults suit local development.
GRIDBRICKS_ENVIRONMENT=development          # development | test | production (production enables caching)
GRIDBRICKS_LOG_LEVEL=INFO
GRIDBRICKS_LOG_JSON=false                   # true for JSON-lines logs
# GRIDBRICKS_DATA_DIR=backend/data/snapshot # where the snapshot lives
# GRIDBRICKS_STATIC_DIR=frontend/dist       # serve the built SPA from FastAPI
GRIDBRICKS_FIRST_DECISION_DATE=2026-01-01
GRIDBRICKS_LAST_DECISION_DATE=2026-01-31
GRIDBRICKS_CALIBRATION_WINDOW_DAYS=14
GRIDBRICKS_CALIBRATION_GAP_DAYS=2
GRIDBRICKS_CALIBRATION_MIN_SAMPLES=48
